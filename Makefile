SHELL := bash

SCRIPT_FILES := $(shell find . -type f -name '*.sh' -not -path './.git/*' | sort)
# The Xray modules share globals across files, so they are linted as one
# freshly assembled installer. xray/xray-install.sh is generated by CI.
XRAY_MODULES := $(filter ./xray/src/%,$(SCRIPT_FILES))
LINT_FILES := $(filter-out $(XRAY_MODULES) ./xray/xray-install.sh,$(SCRIPT_FILES))
TEST_FILES := $(shell find . -type f -path '*/tests/test_*.sh' -not -path './.git/*' | sort)
PYTHON_FILES := $(shell find . -type f -name '*.py' -not -path './.git/*' | sort)
XRAY_BUILD := xray/build.sh

.PHONY: check syntax lint test python-test xray-build xray-e2e

check: syntax lint test

xray-build:
	@$(XRAY_BUILD)

# Needs Docker and network access; downloads the latest stable and pre-release cores.
xray-e2e:
	@xray/tests/e2e/run.sh

syntax:
	@for file in $(SCRIPT_FILES); do \
		bash -n "$$file"; \
	done
	@echo "Bash syntax OK"
	@python3 -m py_compile $(PYTHON_FILES)
	@echo "Python syntax OK"

lint:
	@if command -v shellcheck >/dev/null 2>&1; then \
		bundle=$$(mktemp -d) && trap 'rm -rf "$$bundle"' EXIT && \
		XRAY_BUILD_OUTPUT="$$bundle/xray-install.sh" $(XRAY_BUILD) >/dev/null && \
		shellcheck --shell=bash --severity=warning $(LINT_FILES) "$$bundle/xray-install.sh"; \
	else \
		echo "shellcheck not installed; skipped local lint"; \
	fi

test: python-test
	@for file in $(TEST_FILES); do \
		echo "==> $$file"; \
		bash "$$file" || exit 1; \
	done

python-test:
	@if python3 -c 'import pytest' >/dev/null 2>&1; then \
		python3 -m pytest -q -p no:cacheprovider tools/tests; \
	else \
		echo "pytest not installed; skipped Python tests (pip install -r requirements-dev.txt)"; \
	fi
