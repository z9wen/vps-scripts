---
import Base from "../../../shared/Base.astro";

const games = [
  { cover: "a", title: "__GAME1__", text: "叙事解谜，单人游玩约 8 小时。获年度独立游戏叙事提名。", tags: ["已发售", "PC", "Switch"] },
  { cover: "b", title: "__GAME2__", text: "温和的经营模拟。每天早上五点开门，记住每位熟客的口味。", tags: ["已发售", "PC", "iOS", "Android"] },
  { cover: "c", title: "__GAME3__", text: "正在原型阶段的航海探索游戏。我们会在开发日志里持续分享进度。", tags: ["开发中", "PC"] },
];
const news = [
  ["__DATE1__", "__GAME3__：第一次完整跑通了一趟航线"],
  ["__DATE2__", "《__GAME1__》1.3 版本更新：新增简体中文配音与无障碍字幕"],
  ["__DATE3__", "我们是怎么用三周时间重写灯光系统的"],
  ["__DATE4__", "《__GAME2__》移动版上线，感谢所有参加测试的玩家"],
];
const jobs = [
  ["客户端程序（Unity）", "三年以上游戏客户端经验，熟悉渲染管线与性能分析，喜欢慢节奏的游戏。"],
  ["2D 场景美术", "擅长氛围与光影，能独立完成从草图到成品的场景，请附作品集。"],
];
---
<Base
  title="__NAME__ __NAME_EN__ · 独立游戏工作室"
  description="__NAME__是一家小型独立游戏工作室，作品《__GAME1__》《__GAME2__》。"
  icon="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='16' fill='hsl(__HUE__,70%25,58%25)'/%3E%3Cpath d='M6 22l7-8 5 5 3-3 5 6z' fill='%23111'/%3E%3C/svg%3E"
>
  <div class="wrap">
    <div class="nav">
      <a class="logo" href="/">__NAME__<small>__NAME_EN__</small></a>
      <ul>
        <li><a href="#games">作品</a></li>
        <li><a href="#news">动态</a></li>
        <li><a href="#jobs">加入我们</a></li>
        <li><a href="#contact">联系</a></li>
      </ul>
    </div>

    <div class="hero">
      <svg viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
        <path class="far" d="M0 210 L140 120 L260 190 L400 90 L560 200 L700 110 L860 190 L1000 100 L1200 180 L1200 300 L0 300Z" />
        <path class="near" d="M0 250 L180 170 L330 240 L520 160 L700 250 L880 180 L1060 240 L1200 200 L1200 300 L0 300Z" />
        <rect class="tower" x="930" y="150" width="14" height="70" />
        <rect class="lamp" x="926" y="140" width="22" height="12" />
      </svg>
      <div class="hero-text">
        <span class="tag">最新作品 · 已在 PC 与主机平台发售</span>
        <h1>《__GAME1__》</h1>
        <p>__GAME1_STORY__</p>
        <div class="btns"><a class="btn main" href="#games">查看作品</a><a class="btn alt" href="#news">开发日志</a></div>
      </div>
    </div>

    <section id="games">
      <h2>作品<small>三个人，七年，三款游戏</small></h2>
      <div class="games">
        {games.map((game) => (
          <div class="game">
            <div class={`cover ${game.cover}`}></div>
            <div class="game-body">
              <h3>{game.title}</h3>
              <p>{game.text}</p>
              <div class="chips">{game.tags.map((tag) => <span>{tag}</span>)}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="news">
      <h2>开发日志</h2>
      <div class="news">{news.map(([date, title]) => <a href="#news"><time>{date}</time><b>{title}</b></a>)}</div>
    </section>

    <section id="jobs">
      <h2>加入我们<small>远程优先，每年两次线下聚会</small></h2>
      <div class="jobs">{jobs.map(([title, text]) => <div class="job"><h3>{title}</h3><p>{text}</p></div>)}</div>
    </section>
  </div>
  <footer id="contact">
    <div class="wrap"><span>© __YEAR__ __NAME__ __NAME_EN__</span><span>商务与媒体合作：<a href="mailto:contact@__DOMAIN__">contact@__DOMAIN__</a></span></div>
  </footer>
</Base>

<style is:global>
  :root {
    --bg: #0e0f14;
    --panel: #171922;
    --ink: #eef0f6;
    --muted: #9a9fb0;
    --line: #262938;
    --accent: hsl(var(--hue) 80% 66%);
    --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); line-height: 1.7; }
  a { color: inherit; text-decoration: none; }
</style>

<style>
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 24px; }
  .nav { display: flex; justify-content: space-between; align-items: center; height: 68px; }
  .logo { font-weight: 800; font-size: 19px; letter-spacing: 0.02em; }
  .logo small { color: var(--muted); font-weight: 500; margin-left: 8px; font-size: 13px; }
  .nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; color: var(--muted); font-size: 15px; }
  .nav a:hover { color: var(--ink); }
  .hero { position: relative; border-radius: 22px; overflow: hidden; min-height: 440px; margin-top: 8px; display: flex; align-items: flex-end;
    background: linear-gradient(180deg, hsl(var(--hue) 45% 22%) 0%, hsl(var(--hue) 55% 12%) 55%, #07080c 100%); }
  .hero::before { content: ""; position: absolute; inset: 0; background:
    radial-gradient(circle at 78% 26%, hsl(calc(var(--hue) + 40) 90% 80%) 0 34px, transparent 36px),
    radial-gradient(circle at 78% 26%, hsl(calc(var(--hue) + 40) 90% 75% / 0.35) 0 80px, transparent 140px),
    radial-gradient(1px 1px at 20% 20%, #fff 50%, transparent 51%),
    radial-gradient(1px 1px at 35% 12%, #fff 50%, transparent 51%),
    radial-gradient(1.5px 1.5px at 55% 30%, #fff 50%, transparent 51%),
    radial-gradient(1px 1px at 12% 40%, #fff 50%, transparent 51%),
    radial-gradient(1px 1px at 62% 14%, #fff 50%, transparent 51%); }
  .hero svg { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 62%; }
  .far { fill: hsl(var(--hue) 40% 16%); }
  .near { fill: hsl(var(--hue) 45% 10%); }
  .tower { fill: #d9d2bf; }
  .lamp { fill: #f6c35b; }
  .hero-text { position: relative; padding: 40px 44px; max-width: 620px; }
  .tag { display: inline-block; font-size: 12px; padding: 3px 10px; border-radius: 999px; background: rgb(255 255 255 / 0.12); margin-bottom: 12px; }
  .hero h1 { font-size: 46px; margin: 0 0 10px; line-height: 1.15; }
  .hero p { margin: 0 0 22px; color: #cdd1de; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { padding: 11px 20px; border-radius: 10px; font-weight: 700; font-size: 15px; }
  .btn.main { background: var(--accent); color: #0e0f14; }
  .btn.alt { border: 1px solid rgb(255 255 255 / 0.25); }
  section { padding: 76px 0 0; }
  h2 { font-size: 28px; margin: 0 0 26px; display: flex; align-items: baseline; gap: 14px; }
  h2 small { font-size: 14px; color: var(--muted); font-weight: 500; }
  .games { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .game { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .cover { height: 180px; position: relative; }
  .cover.a { background: linear-gradient(160deg, hsl(var(--hue) 60% 35%), hsl(calc(var(--hue) + 40) 70% 25%)); }
  .cover.a::after { content: ""; position: absolute; left: 24px; bottom: 0; width: 26px; height: 92px; background: #e9e2d0; border-radius: 4px 4px 0 0; box-shadow: 0 -14px 0 -6px #f6c35b; }
  .cover.b { background: linear-gradient(180deg, #f4c99b, #e58f6b); }
  .cover.b::after { content: ""; position: absolute; right: 30px; bottom: 0; width: 110px; height: 70px; background: #6b3f2a; clip-path: polygon(0 30%, 50% 0, 100% 30%, 100% 100%, 0 100%); }
  .cover.c { background: repeating-linear-gradient(135deg, #1d2030 0 14px, #232738 14px 28px); }
  .game-body { padding: 18px 20px 22px; }
  .game-body h3 { margin: 0 0 6px; font-size: 19px; }
  .game-body p { margin: 0 0 12px; color: var(--muted); font-size: 15px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chips span { font-size: 12px; padding: 2px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .news { border-top: 1px solid var(--line); }
  .news a { display: grid; grid-template-columns: 120px 1fr; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .news time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .news a:hover b { color: var(--accent); }
  .jobs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .job { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 22px; }
  .job h3 { margin: 0 0 6px; }
  .job p { margin: 0; color: var(--muted); font-size: 15px; }
  footer { margin-top: 80px; border-top: 1px solid var(--line); padding: 30px 0; color: var(--muted); font-size: 14px; }
  footer .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  footer a { color: var(--accent); }
  @media (max-width: 860px) {
    .games, .jobs { grid-template-columns: 1fr; }
    .hero h1 { font-size: 34px; }
    .hero-text { padding: 28px; }
    .nav ul { display: none; }
    .news a { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
