---
// What a CDN or media edge node shows when its own host name is opened
// (e.g. vod-s1.example.com): the node's parameters and nothing else. The
// installer derives the node name and service from the domain.
import Base from "../../../shared/Base.astro";

const parameters = [
  ["node", "__NODE__"],
  ["hostname", "__DOMAIN__"],
  ["service", "__SERVICE__"],
  ["region", "__COUNTRY__"],
  ["pop", "__POP__"],
  ["origin", "__ORIGIN__"],
  ["cache", "__CACHE__ · hit ratio __HIT__"],
  ["protocols", "HTTP/1.1, HTTP/2, TLS 1.2/1.3"],
  ["software", "edge-node/__VERSION__"],
  ["online since", "__SINCE__"],
  ["last update", "__TODAY__ 04:00 UTC"],
];
---
<Base
  lang="en"
  noindex
  title="__NODE__ · __KIND__"
  description="__BRAND__ __KIND__ __NODE__."
  icon="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='hsl(__HUE__,45%25,32%25)'/%3E%3Cpath d='M9 16h14M16 9v14' stroke='white' stroke-width='3'/%3E%3C/svg%3E"
>
  <main>
    <header>
      <h1>__NODE__</h1>
      <p class="kind">__BRAND__ · __KIND__</p>
      <p class="status"><span></span>online</p>
    </header>
    <table>
      <tbody>{parameters.map(([name, value]) => <tr><th>{name}</th><td>{value}</td></tr>)}</tbody>
    </table>
    <p class="foot">Machine-readable: <a href="/status.json">/status.json</a></p>
  </main>
</Base>

<style is:global>
  :root {
    --ink: #1f2328;
    --muted: #6a737d;
    --line: #e4e7eb;
    --accent: hsl(var(--hue) 50% 38%);
    --ok: #1a7f37;
    --mono: "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fafbfc; color: var(--ink); font-family: var(--mono); font-size: 14px; line-height: 1.6; }
  a { color: var(--accent); }
</style>

<style>
  main { max-width: 640px; margin: 0 auto; padding: 72px 24px; }
  header { margin-bottom: 26px; }
  h1 { margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.01em; }
  .kind { margin: 4px 0 0; color: var(--muted); }
  .status { margin: 14px 0 0; color: var(--ok); }
  .status span { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); margin-right: 8px; }
  table { width: 100%; border-collapse: collapse; border-top: 1px solid var(--line); }
  th, td { text-align: left; padding: 9px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { width: 150px; color: var(--muted); font-weight: 400; }
  td { word-break: break-word; }
  .foot { margin: 22px 0 0; color: var(--muted); font-size: 13px; }
</style>
